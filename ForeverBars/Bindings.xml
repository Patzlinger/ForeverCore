	<Binding name="CLICK ForeverBarsMarkTarget3:LeftButton" category="ADDONS"/>
	<Binding name="CLICK ForeverBarsMarkTarget2:LeftButton" category="ADDONS"/>
	<Binding name="CLICK ForeverBarsMarkTarget1:LeftButton" category="ADDONS"/>
	<Binding name="CLICK ForeverBarsMarkTargetClear:LeftButton" category="ADDONS"/>
	<Binding name="CLICK ForeverBarsMarkWorld8:LeftButton" category="ADDONS"/>
	<Binding name="CLICK ForeverBarsMarkWorld7:LeftButton" category="ADDONS"/>
	<Binding name="CLICK ForeverBarsMarkWorld6:LeftButton" category="ADDONS"/>
	<Binding name="CLICK ForeverBarsMarkWorld5:LeftButton" category="ADDONS"/>
	<Binding name="CLICK ForeverBarsMarkWorld4:LeftButton" category="ADDONS"/>
