<!-- Tastenkürzel für das Blizzard-Menü "Tastaturbelegung" (Bereich AddOns).
     Diese Datei lädt das Spiel automatisch; die Namen kommen aus Core.lua (BINDING_NAME_...). -->
<Bindings>
	<Binding name="FOREVERBARS_OPTIONS" header="FOREVERBARS" category="ADDONS">
		ForeverBars_ToggleOptions()
	</Binding>
	<Binding name="FOREVERBARS_UNLOCK" category="ADDONS">
		ForeverBars_ToggleUnlock()
	</Binding>
	<!-- Markierungsleiste: je Knopf eine Belegung (geschützte Knöpfe, siehe Bars.lua MarkButton; Namen setzt Core.lua) -->
	<Binding name="CLICK ForeverBarsMarkTarget8:LeftButton" header="FOREVERBARS_MARKS" category="ADDONS"/>
	<Binding name="CLICK ForeverBarsMarkTarget7:LeftButton" category="ADDONS"/>
	<Binding name="CLICK ForeverBarsMarkTarget6:LeftButton" category="ADDONS"/>
